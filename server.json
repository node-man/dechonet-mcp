{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.dechonet/mcp",
  "description": "23 security tools for AI agents: phishing links, exposure maps, DNS, SSL, PQC, headers, email.",
  "repository": {
    "url": "https://github.com/node-man/dechonet-mcp",
    "source": "github"
  },
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "dechonet-mcp",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "API base URL (default: https://dechonet.com)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "DECHONET_URL"
        },
        {
          "description": "Response language: en or ko (default: en)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "DECHONET_LOCALE"
        }
      ]
    }
  ],
  "websiteUrl": "https://dechonet.com/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://dechonet.com/mcp"
    }
  ]
}
